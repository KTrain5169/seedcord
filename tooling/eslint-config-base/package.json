{
    "name": "@seedcord/eslint-config-base",
    "version": "0.0.1",
    "private": true,
    "description": "Internal ESLint config content, bundled into @seedcord/eslint-config",
    "repository": {
        "type": "git",
        "url": "https://github.com/seedcord/seedcord.git",
        "directory": "tooling/eslint-config-base"
    },
    "type": "module",
    "types": "./dist/index.d.mts",
    "exports": {
        ".": {
            "import": {
                "types": "./dist/index.d.mts",
                "default": "./dist/index.mjs"
            }
        },
        "./prettier": {
            "import": {
                "types": "./dist/prettier.d.mts",
                "default": "./dist/prettier.mjs"
            }
        },
        "./oxfmt": {
            "import": {
                "types": "./dist/oxfmt.d.mts",
                "default": "./dist/oxfmt.mjs"
            }
        }
    },
    "scripts": {
        "build": "vp pack",
        "clean": "rm -rf dist",
        "lint": "vp lint '**/*.ts'",
        "lint:fix": "vp lint '**/*.ts' --fix",
        "fmt": "vp fmt --write '**/*.{ts,json,md}' --no-error-on-unmatched-pattern",
        "fmt:check": "vp fmt --check '**/*.{ts,json,md}' --no-error-on-unmatched-pattern",
        "tc": "tsgo --noEmit"
    },
    "dependencies": {
        "eslint-import-resolver-typescript": "catalog:eslint",
        "eslint-plugin-security": "catalog:eslint",
        "eslint-plugin-tsdoc": "catalog:eslint",
        "lodash.merge": "catalog:deps",
        "prettier": "catalog:deps"
    },
    "devDependencies": {
        "@seedcord/tsconfig": "workspace:^",
        "@types/lodash.merge": "^4.6.9"
    },
    "peerDependencies": {
        "prettier-plugin-tailwindcss": "catalog:deps",
        "tailwindcss": "catalog:deps",
        "typescript": "catalog:peer"
    },
    "peerDependenciesMeta": {
        "prettier-plugin-tailwindcss": {
            "optional": true
        },
        "tailwindcss": {
            "optional": true
        },
        "eslint-plugin-mdx": {
            "optional": true
        },
        "eslint-plugin-better-tailwindcss": {
            "optional": true
        },
        "eslint-plugin-tailwind-canonical-classes": {
            "optional": true
        }
    },
    "engines": {
        "bun": ">=1.4.2",
        "node": ">=24.11"
    }
}
