{
    "name": "eslint-plugin-discordjs",
    "version": "0.1.7",
    "description": "ESLint rules for discord.js bots",
    "keywords": [
        "discord-bot",
        "discordjs",
        "eslint",
        "eslint-plugin",
        "eslintplugin"
    ],
    "homepage": "https://github.com/seedcord/seedcord/tree/next/tooling/eslint-plugin-discordjs#readme",
    "bugs": "https://github.com/seedcord/seedcord/issues",
    "license": "Apache-2.0",
    "author": "Dhruv <materwelondhruv@gmail.com> (https://materwelon.dev)",
    "repository": {
        "type": "git",
        "url": "https://github.com/seedcord/seedcord.git",
        "directory": "tooling/eslint-plugin-discordjs"
    },
    "funding": "https://github.com/sponsors/materwelonDhruv",
    "files": [
        "dist",
        "package.json",
        "README.md",
        "LICENSE"
    ],
    "type": "module",
    "types": "./dist/index.d.mts",
    "imports": {
        "#tests/*": "./tests/*.ts",
        "#src/*": "./src/*.ts"
    },
    "exports": {
        ".": {
            "types": "./dist/index.d.mts",
            "default": "./dist/index.mjs"
        }
    },
    "publishConfig": {
        "access": "public",
        "provenance": true
    },
    "scripts": {
        "build": "vp pack",
        "clean": "rm -rf dist",
        "lint": "vp lint '**/*.{ts,tsx}'",
        "lint:fix": "vp lint '**/*.{ts,tsx}' --fix",
        "fmt": "vp fmt --write '**/*.{ts,tsx,json,md}' --no-error-on-unmatched-pattern",
        "fmt:check": "vp fmt --check '**/*.{ts,tsx,json,md}' --no-error-on-unmatched-pattern",
        "tc": "tsgo --noEmit",
        "test": "vp test run",
        "test:watch": "vp test dev",
        "coverage": "vp test run --coverage"
    },
    "dependencies": {
        "@typescript-eslint/utils": "catalog:eslint"
    },
    "devDependencies": {
        "@seedcord/eslint-utils": "workspace:^",
        "@seedcord/tsconfig": "workspace:^",
        "@seedcord/tsdown-config": "workspace:^",
        "@seedcord/vitest-config": "workspace:^",
        "dedent": "catalog:test",
        "discord.js": "catalog:peer",
        "vitest": "catalog:test"
    },
    "peerDependencies": {
        "typescript": "catalog:consumerLint"
    },
    "engines": {
        "bun": ">=1.4.2",
        "node": ">=24.11"
    }
}
