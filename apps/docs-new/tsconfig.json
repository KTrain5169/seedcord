{
    "extends": "astro/tsconfigs/strict",
    "include": [".astro/types.d.ts", "**/*", "./worker-configuration.d.ts"],
    "exclude": ["dist"],
    "compilerOptions": {
        "types": ["react", "react-dom"],
        "jsx": "react-jsx",
        "jsxImportSource": "react",
        "paths": {
            "#components/*": ["./src/components/*"],
            "#lib/*": ["./src/lib/*"],
            "#store/*": ["./src/store/*"]
        }
    }
}
