---
import { AgentLinks, DOCS, seedcordJsonLd, cn } from '@seedcord/ui';
import { FAVICON_SIZE } from '@seedcord/ui/MaterwelonFavicon';
import { Font } from 'astro:assets';
import { ClientRouter } from 'astro:transitions';

import '../styles/globals.css';

import { NavbarIsland } from '#components/header/NavbarIsland';
import { CommandPalette } from '#components/search/command-palette';
import { DocsPage, type PageHead } from '#lib/docs/DocsPage';
import { FOREGROUND_HEX } from '#lib/entityColors';
import { relativePath } from '#lib/pathname';
import { OG_SITE_NAME, SITE_DESCRIPTION, SITE_NAME, SITE_URL } from '#lib/site';

interface Props {
    // the pages carry their own head facts. a page that passes none takes the layout default
    head?: PageHead;
    // entity pages carry their own tone and structured data
    themeColor?: { light: string; dark: string };
    jsonLd?: Record<string, unknown>;
}

const {
    head = { ...DocsPage.root().head(), title: 'seedcord docs' },
    themeColor = FOREGROUND_HEX,
    jsonLd = seedcordJsonLd({ name: OG_SITE_NAME, url: SITE_URL, description: SITE_DESCRIPTION })
} = Astro.props;

const { pathname } = Astro.url;
// the navbar reads the served path to decide whether a package page sits under it
const relative = relativePath(pathname);

// a raw < in the JSON would end the script tag
const jsonLdText = JSON.stringify(jsonLd).replace(/</g, '\\u003c');

const robots =
    head.noindex || head.nofollow
        ? `${head.noindex ? 'noindex' : 'index'}, ${head.nofollow ? 'nofollow' : 'follow'}`
        : 'index, follow';

// the icon route answers extensionless. the worker maps /docs/icon to the icon build key
const ICON = { url: `${DOCS.path}/icon`, type: 'image/png', sizes: `${FAVICON_SIZE.width}x${FAVICON_SIZE.height}` };
---

<html lang="en" data-scroll-behavior="smooth" transition:animate="none">
    <head>
        <meta charset="utf-8" />
        <meta name="viewport" content="width=device-width, initial-scale=1" />
        <title>{head.title}</title>
        <meta name="description" content={head.description} />
        <meta name="application-name" content={SITE_NAME} />
        <meta name="robots" content={robots} />
        <link rel="canonical" href={head.canonical} />
        {head.markdownUrl && <link rel="alternate" type="text/markdown" href={head.markdownUrl} />}
        <meta property="og:type" content={head.ogType} />
        <meta property="og:site_name" content={OG_SITE_NAME} />
        <meta property="og:url" content={head.canonical} />
        <meta property="og:title" content={head.title} />
        <meta property="og:description" content={head.description} />
        <meta property="og:image" content={head.image.url} />
        <meta property="og:image:width" content={String(head.image.width)} />
        <meta property="og:image:height" content={String(head.image.height)} />
        <meta property="og:image:alt" content={head.image.alt} />
        <meta name="twitter:card" content="summary_large_image" />
        <meta name="twitter:title" content={head.title} />
        <meta name="twitter:description" content={head.description} />
        <meta name="twitter:image" content={head.image.url} />
        <meta name="theme-color" media="(prefers-color-scheme: light)" content={themeColor.light} />
        <meta name="theme-color" media="(prefers-color-scheme: dark)" content={themeColor.dark} />
        <link rel="icon" type={ICON.type} sizes={ICON.sizes} href={ICON.url} />
        {/* the R2-backed CDN serves the README banner, the page's LCP image */}
        <link rel="preconnect" href="https://cdn.seedcord.org" crossorigin />
        <AgentLinks site="docs" />
        <script type="application/ld+json" set:html={jsonLdText} />
        {/* code keeps tailwind's ui-monospace default. a webfont mono at 12px renders a pixel high in the chips */}
        <Font cssVariable="--font-display" />
        <ClientRouter />
    </head>
    <body class={cn('antialiased')} data-new-gr-c-s-check-loaded="" data-gr-ext-installed="">
        <script is:inline>
            (function () {
                var ATTRIBUTES = ['data-new-gr-c-s-check-loaded', 'data-gr-ext-installed'];
                var selector = ATTRIBUTES.map(function (attr) {
                    return '[' + attr + ']';
                }).join(',');

                function stripAttributes() {
                    if (!selector) {
                        return;
                    }

                    var nodes = document.querySelectorAll(selector);

                    Array.prototype.forEach.call(nodes, function (node) {
                        ATTRIBUTES.forEach(function (attr) {
                            if (node.hasAttribute && node.hasAttribute(attr)) {
                                node.removeAttribute(attr);
                            }
                        });
                    });
                }

                // Grammarly adds its attributes again after the first strip
                function runCleanup() {
                    stripAttributes();
                    setTimeout(stripAttributes, 0);
                }

                if (document.readyState === 'loading') {
                    document.addEventListener('DOMContentLoaded', runCleanup, { once: true });
                } else {
                    runCleanup();
                }
            })();
        </script>
        {/* a page further down the sidebar slides in from below. the order rides on main#main-content */}
        <script is:inline>
            document.addEventListener('astro:before-swap', function (event) {
                var order = [];
                try {
                    order = JSON.parse(document.querySelector('main#main-content')?.dataset.navOrder ?? '[]');
                } catch {
                    order = [];
                }

                var from = event.from ? event.from.pathname : location.pathname;
                var to = event.to ? event.to.pathname : from;
                var direction = order.indexOf(to) < order.indexOf(from) ? 'prev' : 'next';
                event.newDocument.documentElement.dataset.navDir = direction;
            });
        </script>
        <CommandPalette client:load />
        <a
            href="#main-content"
            class={cn(
                'fixed top-4 left-6 z-60 -translate-y-20 transform rounded-full bg-(--rind) px-4 py-2 text-sm font-semibold text-black transition focus-visible:translate-y-0'
            )}
        >
            Skip to content
        </a>
        <div class={cn('flex min-h-screen flex-col')}>
            <NavbarIsland client:load pathname={relative} />
            <div class={cn('flex-1 pt-(--nav-h)')}>
                <slot />
            </div>
        </div>
    </body>
</html>
