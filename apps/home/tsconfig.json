{
    "$schema": "https://json.schemastore.org/tsconfig",
    "extends": "@seedcord/tsconfig/base",
    "compilerOptions": {
        "lib": ["ESNext", "DOM", "DOM.Iterable"],
        "allowJs": true,
        "jsx": "preserve",
        "rootDir": ".",
        "plugins": [
            {
                "name": "next"
            }
        ],
        "incremental": true,
        "esModuleInterop": true,
        "allowImportingTsExtensions": true
    },
    "include": [
        "next-env.d.ts",
        "src/**/*.ts",
        "src/**/*.tsx",
        "src/app/.well-known/**/*.ts",
        "eslint.config.ts",
        "prettier.config.ts",
        "next.config.ts",
        ".next/types/**/*.ts",
        "worker.ts"
    ],
    "exclude": ["node_modules", "dist"]
}
