{
    "name": "@seedcord/home",
    "version": "0.0.2",
    "private": true,
    "type": "module",
    "imports": {
        "#src/*": "./src/*.ts",
        "#components/*": "./src/components/*",
        "#ui/*": "./src/components/ui/*",
        "#lib/*": "./src/lib/*",
        "#styles/*": "./src/app/*.ts"
    },
    "scripts": {
        "dev": "next dev",
        "build": "next build",
        "start": "vp dlx serve dist",
        "deploy": "wrangler deploy",
        "deploy:preview": "wrangler versions upload",
        "lint": "vp lint '**/*.{ts,tsx}'",
        "lint:fix": "vp lint '**/*.{ts,tsx}' --fix",
        "fmt": "vp fmt --write '**/*.{ts,tsx,json,md,css}' --no-error-on-unmatched-pattern",
        "fmt:check": "vp fmt --check '**/*.{ts,tsx,json,md,css}' --no-error-on-unmatched-pattern",
        "tc": "tsgo --noEmit"
    },
    "dependencies": {
        "@seedcord/ui": "workspace:^",
        "discord-component-embed": "workspace:^",
        "lucide-react": "catalog:deps",
        "motion": "catalog:deps",
        "next": "catalog:deps",
        "react": "catalog:react",
        "react-dom": "catalog:react",
        "shiki": "catalog:deps",
        "takumi-js": "catalog:deps"
    },
    "devDependencies": {
        "@seedcord/tsconfig": "workspace:^",
        "@tailwindcss/postcss": "catalog:deps",
        "@types/react": "catalog:react",
        "@types/react-dom": "catalog:react",
        "prettier": "catalog:deps",
        "prettier-plugin-tailwindcss": "catalog:deps",
        "tailwindcss": "catalog:deps",
        "typescript": "catalog:peer",
        "wrangler": "catalog:peer"
    },
    "engines": {
        "node": ">=24.11"
    }
}
