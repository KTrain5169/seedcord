{
    "extends": "astro/tsconfigs/strict",
    "include": [".astro/types.d.ts", "**/*", "./worker-configuration.d.ts", "src/pages/.well-known/[skill-paths]"],
    "exclude": ["dist"],
    "compilerOptions": {
        "jsx": "react-jsx",
        "jsxImportSource": "react",
        "paths": {
            "#src/*": ["./src/*"],
            "#components/*": ["./src/components/*"],
            "#ui/*": ["./src/components/ui/*"],
            "#lib/*": ["./src/lib/*"],
            "#styles/*": ["./src/app/*"]
        }
    }
}
